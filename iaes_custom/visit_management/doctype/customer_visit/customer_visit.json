   "in_list_view": 1
  },
  {
   "fieldname": "column_break_visit",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "visit_date",
   "fieldtype": "Date",
   "label": "Visit Date",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
