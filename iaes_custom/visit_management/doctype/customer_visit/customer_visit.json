  },
  {
   "fieldname": "objective_section",
   "fieldtype": "Section Break",
   "label": "Objective"
  },
  {
   "fieldname": "visit_objective",
   "fieldtype": "Small Text",
   "label": "Visit Objective",
   "reqd": 1,
   "description": "What this visit is intended to achieve."
  },
  {
   "fieldname": "pre_visit_remarks",
   "fieldtype": "Text Editor",
   "label": "Pre-Visit Remarks"
  },
  {
   "fieldname": "outcome_section",
   "fieldtype": "Section Break",
   "label": "Visit Outcome",
   "depends_on": "eval:!doc.__islocal && doc.status!=\"Cancelled\""
  },
  {
   "fieldname": "actual_visit_date",
   "fieldtype": "Date",
   "label": "Actual Visit Date",
   "mandatory_depends_on": "eval:doc.status==\"Closed\""
  },
  {
   "fieldname": "visit_outcome",
   "fieldtype": "Select",
   "label": "Visit Outcome",
   "options": "\nSuccessful - Objective Achieved\nPartially Successful\nPostponed by Customer\nCustomer Unavailable\nCancelled",
   "mandatory_depends_on": "eval:doc.status==\"Closed\"",
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_outcome",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "next_step",
   "fieldtype": "Select",
   "label": "Next Step",
   "options": "\nSend / Revise Quotation\nSchedule Next Visit\nAwait Customer Decision\nEscalate Internally\nTechnical Follow-up Required\nClosed - Won\nClosed - Lost\nNo Further Action",
   "mandatory_depends_on": "eval:doc.status==\"Closed\""
  },
  {
   "fieldname": "closing_remarks_section",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "closing_remarks",
   "fieldtype": "Text Editor",
   "label": "Closing Remarks",
   "mandatory_depends_on": "eval:doc.status==\"Closed\"",
   "description": "The meeting notes. This is the field the reports are read against."
  },
  {
   "fieldname": "followup_section",
   "fieldtype": "Section Break",
   "label": "Follow-up",
   "depends_on": "eval:!doc.__islocal && doc.status!=\"Cancelled\""
  },
  {
   "fieldname": "follow_up_required",
   "fieldtype": "Check",
   "label": "Follow-up Required"
  },
  {
   "fieldname": "follow_up_type",
   "fieldtype": "Select",
   "label": "Follow-up Type",
   "options": "\nCall\nEmail\nSite Visit\nSend Quotation\nInternal Action",
   "depends_on": "follow_up_required",
   "mandatory_depends_on": "eval:doc.follow_up_required==1"
  },
  {
   "fieldname": "follow_up_date",
   "fieldtype": "Date",
   "label": "Follow-up Date",
   "depends_on": "follow_up_required",
   "mandatory_depends_on": "eval:doc.follow_up_required==1"
  },
