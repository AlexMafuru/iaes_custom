   "fieldname": "contact_email",
   "fieldtype": "Data",
   "label": "Email",
   "read_only": 1,
   "options": "Email"
  },
  {
   "fieldname": "classification_section",
   "fieldtype": "Section Break",
   "label": "Classification"
  },
  {
   "fieldname": "visit_purpose",
   "fieldtype": "Select",
   "label": "Visit Purpose",
