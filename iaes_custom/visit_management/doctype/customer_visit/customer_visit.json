  },
  {
   "fieldname": "reference_section",
   "fieldtype": "Section Break",
   "label": "Related Documents"
  },
  {
   "fieldname": "visit_references",
   "fieldtype": "Table",
   "label": "References",
   "options": "Visit Reference",
